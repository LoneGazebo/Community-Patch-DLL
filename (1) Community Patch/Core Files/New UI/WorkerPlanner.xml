<?xml version="1.0" encoding="utf-8"?>
<Context Font="TwCenMT18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" Hidden="1">

	<!-- One improvement choice in the selected tile panel -->
	<Instance Name="OptionInstance">
		<Button ID="OptionButton" Size="250,40" Anchor="L,T">
			<ShowOnMouseOver>
				<AlphaAnim Anchor="L,C" Size="250,40" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="1" AlphaEnd="0.5">
					<Grid Size="250,40" Offset="0,0" Padding="0,0" Style="Grid9FrameTurnsHL"/>
				</AlphaAnim>
			</ShowOnMouseOver>
			<Grid ID="SelectedFrame" Size="250,40" Offset="0,0" Padding="0,0" Style="Grid9FrameTurns" Hidden="1"/>
			<Image ID="OptionIcon" Anchor="L,C" Offset="2,0" Size="45,45" Texture="UnitActions360.dds"/>
			<Label ID="OptionName" Anchor="L,T" Offset="48,4" Font="TwCenMT16" TruncateWidth="150"/>
			<Label ID="OptionInfo" Anchor="L,B" Offset="48,4" Font="TwCenMT14" ColorSet="Gray_Black" TruncateWidth="195"/>
			<Label ID="OptionScore" Anchor="R,C" Offset="8,0" Font="TwCenMT14"/>
		</Button>
	</Instance>

	<!-- Icon shown on the map -->
	<Instance Name="MapIconInstance">
		<WorldAnchor ID="Anchor" Scaling="True" DepthAdjust="-25">
			<Image ID="Frame" Anchor="C,C" Size="64,64" Texture="IconFrame64.dds"/>
			<Image ID="Icon" Anchor="C,C" Size="64,64" Texture="UnitActions360.dds"/>
			<!-- Same size as the icon, extras go outside it -->
			<Box Anchor="C,C" Size="64,64" Color="0,0,0,0">
				<Image ID="InterimIcon" Anchor="R,B" AnchorSide="O,I" Size="45,45" Texture="UnitActions360.dds" Hidden="1"/>
				<Label ID="ScoreLabel" Anchor="C,B" AnchorSide="I,O" Font="TwCenMT20" FontStyle="Stroke" Hidden="1"/>
			</Box>
			<Box ID="BadgeBox" Anchor="R,T" Offset="-8,-8" Size="28,28" Color="0,0,0,200">
				<Label ID="Badge" Anchor="C,C" Font="TwCenMT24" FontStyle="Stroke"/>
			</Box>
		</WorldAnchor>
	</Instance>

	<!-- Status color legend entry -->
	<Instance Name="LegendInstance">
		<Box ID="LegendRoot" Size="125,20" Color="0,0,0,0">
			<Box ID="LegendColor" Anchor="L,C" Size="14,14" Color="255,255,255,255"/>
			<Label ID="LegendLabel" Anchor="L,C" Offset="20,0" Font="TwCenMT14"/>
		</Box>
	</Instance>

	<!-- Pooled map icons live here -->
	<Container ID="MapIcons"/>

	<Grid ID="MainPanel" Size="310,740" Anchor="L,C" Offset="10,-10" Padding="0,0" Style="Grid9DetailFive140" ConsumeMouse="1">
		<Label Style="MenuTitleCaption" String="TXT_KEY_WP_TITLE"/>

		<!-- Tabs -->
		<Stack Anchor="C,T" Offset="0,44" StackGrowth="Right" Padding="6">
			<GridButton ID="ImprovementsTabButton" Style="SmallButton" Size="100,30" String="TXT_KEY_WP_TAB_IMPROVEMENTS"/>
			<GridButton ID="RoutesTabButton" Style="SmallButton" Size="80,30" String="TXT_KEY_WP_TAB_ROUTES"/>
			<GridButton ID="SettingsTabButton" Style="SmallButton" Size="84,30" String="TXT_KEY_WP_TAB_SETTINGS"/>
		</Stack>

		<!-- Improvements tab -->
		<Box ID="ImprovementsTab" Anchor="L,T" Offset="18,80" Size="276,600" Color="0,0,0,0">
			<Stack ID="ImprovementsStack" Anchor="L,T" StackGrowth="Bottom" Padding="4">
				<!-- Legend, two columns -->
				<Stack ID="LegendStack" Anchor="L,T" StackGrowth="Right" Padding="0">
					<Stack ID="LegendStackLeft" StackGrowth="Bottom" Padding="0"/>
					<Stack ID="LegendStackRight" StackGrowth="Bottom" Padding="0"/>
				</Stack>

				<Image Texture="HorizontalTrim.dds" Size="276,5"/>

				<!-- Selected tile -->
				<Label ID="SelectedTitle" Font="TwCenMT18" WrapWidth="276"/>
				<Label ID="SelectedAI" Font="TwCenMT16" WrapWidth="276"/>
				<Label ID="SelectedStatus" Font="TwCenMT16" WrapWidth="276"/>

				<Box ID="PlanControls" Size="276,60" Color="0,0,0,0">
					<Stack Anchor="L,T" StackGrowth="Right" Padding="4">
						<Label Anchor="L,C" String="TXT_KEY_WP_PRIORITY" Font="TwCenMT16" ToolTip="TXT_KEY_WP_PRIORITY_TT"/>
						<GridButton ID="Priority0" Style="SmallButton" Size="50,26" String="TXT_KEY_WP_PRIORITY_NONE" ToolTip="TXT_KEY_WP_PRIORITY_TT"/>
						<GridButton ID="Priority1" Style="SmallButton" Size="34,26" String="1" ToolTip="TXT_KEY_WP_PRIORITY_TT"/>
						<GridButton ID="Priority2" Style="SmallButton" Size="34,26" String="2" ToolTip="TXT_KEY_WP_PRIORITY_TT"/>
						<GridButton ID="Priority3" Style="SmallButton" Size="34,26" String="3" ToolTip="TXT_KEY_WP_PRIORITY_TT"/>
					</Stack>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="LockCheckBox" Anchor="L,B" IsChecked="0" String="TXT_KEY_WP_LOCK" Font="TwCenMT16" ToolTip="TXT_KEY_WP_LOCK_TT"/>
				</Box>

				<ScrollPanel ID="OptionsScrollPanel" Size="276,190" Vertical="1" AutoScrollBar="1">
					<Stack ID="OptionsStack" StackGrowth="Bottom" Padding="2">
						<GridButton ID="NormalHeader" Style="SmallButton" Size="250,26"/>
						<Stack ID="NormalOptionsStack" StackGrowth="Bottom" Padding="2"/>
						<GridButton ID="GPHeader" Style="SmallButton" Size="250,26"/>
						<Stack ID="GPOptionsStack" StackGrowth="Bottom" Padding="2"/>
					</Stack>
					<ScrollBar ID="OptionsScrollBar" Style="VertSlider" Length="154" Anchor="R,T" AnchorSide="O,I" Offset="-18,18"/>
					<UpButton Style="ScrollBarUp" Anchor="R,T" AnchorSide="O,I" Offset="-18,0"/>
					<DownButton Style="ScrollBarDown" Anchor="R,B" AnchorSide="O,I" Offset="-18,0"/>
				</ScrollPanel>

				<Stack Anchor="L,T" StackGrowth="Right" Padding="6">
					<GridButton ID="ClearPlanButton" Style="SmallButton" Size="135,30" String="TXT_KEY_WP_CLEAR_PLAN" ToolTip="TXT_KEY_WP_CLEAR_PLAN_TT"/>
					<GridButton ID="LeaveAsIsButton" Style="SmallButton" Size="135,30" String="TXT_KEY_WP_LEAVE_AS_IS" ToolTip="TXT_KEY_WP_LEAVE_AS_IS_TT"/>
				</Stack>
				<Label ID="Hint" Font="TwCenMT14" WrapWidth="276" ColorSet="Gray_Black" String="TXT_KEY_WP_HINT"/>
			</Stack>
		</Box>

		<!-- Routes tab -->
		<Box ID="RoutesTab" Anchor="L,T" Offset="18,80" Size="276,600" Color="0,0,0,0" Hidden="1">
			<Stack ID="RoutesStack" Anchor="L,T" StackGrowth="Bottom" Padding="4">
				<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowRoadPlansCheckBox" Anchor="L,T" IsChecked="1" String="TXT_KEY_WP_SHOW_ROAD_PLANS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_ROAD_PLANS_TT"/>
				<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ExplainAutomatedRoutesCheckBox" Anchor="L,T" IsChecked="1" String="TXT_KEY_WP_EXPLAIN_AUTOMATED_ROUTES" Font="TwCenMT16"/>
				<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowCityConnectionsCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_CITY_CONNECTIONS" Font="TwCenMT16"/>

				<!-- Legend, two columns -->
				<Stack ID="RouteLegendStack" Anchor="L,T" StackGrowth="Right" Padding="0">
					<Stack ID="RouteLegendStackLeft" StackGrowth="Bottom" Padding="0"/>
					<Stack ID="RouteLegendStackRight" StackGrowth="Bottom" Padding="0"/>
				</Stack>

				<Image Texture="HorizontalTrim.dds" Size="276,5"/>

				<!-- Selected tile -->
				<Label ID="RouteSelectedTitle" Font="TwCenMT18" WrapWidth="276"/>
				<Label ID="RouteSelectedInfo" Font="TwCenMT16" WrapWidth="276"/>
				<GridButton ID="RoutePlanNoneButton" Style="SmallButton" Size="276,30" ToolTip="TXT_KEY_WP_ROUTE_PLAN_NONE_TT"/>
				<GridButton ID="DrawRoadPlanButton" Style="SmallButton" Size="276,30" ToolTip="TXT_KEY_WP_DRAW_ROAD_PLAN_TT"/>
				<GridButton ID="DrawPriorityButton" Style="SmallButton" Size="276,30" ToolTip="TXT_KEY_WP_DRAW_PRIORITY_ROUTE_TT"/>
				<GridButton ID="DrawNoBuildZoneButton" Style="SmallButton" Size="276,30" ToolTip="TXT_KEY_WP_DRAW_NO_BUILD_ZONE_TT"/>
				<Label ID="RouteHint" Font="TwCenMT14" WrapWidth="276" ColorSet="Gray_Black" String="TXT_KEY_WP_HINT"/>

				<Image Texture="HorizontalTrim.dds" Size="276,5"/>
				<Label String="TXT_KEY_WP_WHOLE_MAP_ACTIONS" Font="TwCenMT18"/>
				<GridButton ID="AllTilesNoBuildButton" Style="SmallButton" Size="276,30" String="TXT_KEY_WP_ALL_NO_BUILD"/>
				<GridButton ID="ResetAllTilesButton" Style="SmallButton" Size="276,30" String="TXT_KEY_WP_ALL_RESET"/>
			</Stack>
		</Box>

		<!-- Settings tab -->
		<Box ID="SettingsTab" Anchor="L,T" Offset="18,80" Size="276,600" Color="0,0,0,0" Hidden="1">
			<Stack ID="SettingsStack" Anchor="L,T" StackGrowth="Bottom" Padding="2">
				<Label String="TXT_KEY_WP_SETTINGS_MAP" Font="TwCenMT18"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowStatusCheckBox" Anchor="L,T" IsChecked="1" String="TXT_KEY_WP_SHOW_STATUS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_STATUS_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowBuiltCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_BUILT" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_BUILT_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowIconsCheckBox" Anchor="L,T" IsChecked="1" String="TXT_KEY_WP_SHOW_ICONS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_ICONS_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowAIChoicesCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_AI_CHOICES" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_AI_CHOICES_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowPlansCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_PLANS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_PLANS_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowGreatPersonCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_GREAT_PERSON" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_GREAT_PERSON_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowInterimCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_INTERIM" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_INTERIM_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowScoresCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_SCORES" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_SCORES_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="ShowChangesCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SHOW_CHANGES" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SHOW_CHANGES_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="OnlyCityCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_ONLY_CITY" Font="TwCenMT16" ToolTip="TXT_KEY_WP_ONLY_CITY_TT"/>

				<Image Texture="HorizontalTrim.dds" Size="276,5"/>
				<Label String="TXT_KEY_WP_SETTINGS_BUILDERS" Font="TwCenMT18" ToolTip="TXT_KEY_WP_SETTINGS_BUILDERS_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="PlansOnlyCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_PLANS_ONLY" Font="TwCenMT16" ToolTip="TXT_KEY_WP_PLANS_ONLY_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="CommitGreatPersonsCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_COMMIT_GREAT_PERSONS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_COMMIT_GREAT_PERSONS_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="LuxuriesFirstCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_LUXURIES_FIRST" Font="TwCenMT16" ToolTip="TXT_KEY_WP_LUXURIES_FIRST_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="StrategicsFirstCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_STRATEGICS_FIRST" Font="TwCenMT16" ToolTip="TXT_KEY_WP_STRATEGICS_FIRST_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="SafeAutomationCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_SAFE_AUTOMATION" Font="TwCenMT16" ToolTip="TXT_KEY_WP_SAFE_AUTOMATION_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="LeaveForestsCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_LEAVE_FORESTS" Font="TwCenMT16" ToolTip="TXT_KEY_WP_LEAVE_FORESTS_TT"/>

				<Image Texture="HorizontalTrim.dds" Size="276,5"/>
				<Label String="TXT_KEY_WP_SETTINGS_NOTIFY" Font="TwCenMT18"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="NotifyUnlockedCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_NOTIFY_UNLOCKED_OPTION" Font="TwCenMT16" ToolTip="TXT_KEY_WP_NOTIFY_UNLOCKED_OPTION_TT"/>
					<CheckBox TextAnchorSide="Right" TextOffset="40,0" ID="NotifyBlockedCheckBox" Anchor="L,T" IsChecked="0" String="TXT_KEY_WP_NOTIFY_BLOCKED_OPTION" Font="TwCenMT16" ToolTip="TXT_KEY_WP_NOTIFY_BLOCKED_OPTION_TT"/>
			</Stack>
		</Box>

		<!-- Close -->
		<Stack Anchor="C,B" Offset="0,22" StackGrowth="Right" Padding="6">
			<GridButton ID="ClearCityPlansButton" Style="SmallButton" Size="100,32" String="TXT_KEY_WP_CLEAR_CITY_PLANS"/>
			<GridButton ID="ClearAllPlansButton" Style="SmallButton" Size="90,32" String="TXT_KEY_WP_CLEAR_ALL_PLANS" ToolTip="TXT_KEY_WP_CLEAR_ALL_PLANS_TT"/>
			<GridButton ID="CloseButton" Style="SmallButton" Size="80,32" String="TXT_KEY_CLOSE"/>
		</Stack>
	</Grid>
</Context>
